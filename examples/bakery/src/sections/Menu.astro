---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs, nodeAttrs, child } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const img = s.image ?? {};
const labels: Record<string, string> = { vegan: 'Vegan', seasonal: 'Seasonal', new: 'New', weekends: 'Weekends' };
---
<Sec node={node} edit={edit} class={`menu--${s.side || 'right'}${img.src ? ' menu--with-image' : ''}`} inner="menu__inner">
  <div class="menu__body">
    <h2 class="sec__title" {...fieldAttrs(edit, 'title', 'text')} set:html={s.title} />
    {s.intro && <div class="rich sec__intro" {...fieldAttrs(edit, 'intro', 'richtext')} set:html={s.intro} />}
    <ul class="menu__list">
      {(node.blocks ?? []).map((m, i) => { const e = child(edit, i); const p = m.settings; return (
        <li class="menu__item" {...nodeAttrs(e, m)}>
          <div class="menu__line">
            <span class="menu__name" {...fieldAttrs(e, 'name', 'text')} set:html={p.name} />
            {p.tag && <span class={`pill pill--${p.tag}`}>{labels[p.tag] ?? p.tag}</span>}
            <span class="menu__dots" aria-hidden="true"></span>
            <span class="menu__price" {...fieldAttrs(e, 'price', 'text')} set:html={p.price} />
          </div>
          {p.text && <p class="menu__desc" {...fieldAttrs(e, 'text', 'text')} set:html={p.text} />}
        </li>); })}
    </ul>
  </div>
  {img.src && <figure class="menu__media"><img src={img.src} alt={img.alt ?? ''} {...fieldAttrs(edit, "image", "image")} /></figure>}
</Sec>
