    {
      "id": "3ff9940",
      "type": "quotes",
      "settings": {
        "eyebrow": "Overheard at the counter",
        "title": "",
        "background": "wheat",
        "anchor": ""
      },
      "blocks": [
        {
          "id": "042b1ec",
          "type": "quote",
          "settings": {
            "quote": "<p>I moved two streets away and I still walk over on Saturdays. The rye alone is worth it.</p>",
            "name": "Priya S.",
            "detail": "Regular since the garage days"
          }
        },
        {
          "id": "3871f0b",
          "type": "quote",
          "settings": {
            "quote": "<p>They remembered my kid’s name and that she only likes the end of the baguette.</p>",
            "name": "Tom H.",
            "detail": "Larder Lane neighbour"
          }
        },
        {
          "id": "a5657da",
          "type": "quote",
          "settings": {
            "quote": "<p>The croissant you think about on Tuesday, when they’re closed.</p>",
            "name": "Ana R.",
            "detail": "Weekend regular"
          }
        }
      ]
    },
    {
      "id": "53f62a5",
      "type": "hours",
      "settings": {
        "eyebrow": "Come by",
        "title": "Hours and where to find us",
        "text": "<p><strong>14 Larder Lane, Millbrook</strong><br>Between the bike shop and the library, look for the striped awning.</p><p>Street parking on Larder Lane, a bike rack out front, and the No. 6 bus stops at the corner.</p>",
        "note": "We close early when the shelves are empty. Check our news for holiday hours.",
        "background": "paper",
        "anchor": ""
      },
