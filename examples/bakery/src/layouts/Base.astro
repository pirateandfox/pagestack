---
// The site frame: announcement bar, header, footer. Every page (block pages, news) renders inside it.
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
import '../styles/global.css';
interface Props { title: string; description?: string; announcement?: boolean }
const { title, description, announcement = true } = Astro.props;
const here = Astro.url.pathname.replace(/\/?$/, '/');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Home' ? 'Crumb & Co. — Neighbourhood bakery' : `${title} — Crumb & Co.`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap" />
  </head>
  <body>
    {announcement && site.announcement && <p class="announce"><span class="announce__dot" aria-hidden="true"></span>{site.announcement}</p>}
    <header class="header">
      <div class="wrap header__inner">
        <a class="header__logo" href="/" aria-label="Crumb & Co., home"><Logo /></a>
        <nav class="nav" aria-label="Main">
          {site.nav.map((l) => <a class:list={['nav__link', here.startsWith(l.href) && 'is-current']} href={l.href}>{l.label}</a>)}
        </nav>
        <a class="btn btn--small header__cta" href={site.orderHref}>{site.orderLabel}</a>
        <details class="menu">
          <summary class="menu__toggle" aria-label="Open menu"><span></span><span></span></summary>
          <nav class="menu__panel" aria-label="Main">
            {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
            <a class="btn" href={site.orderHref}>{site.orderLabel}</a>
          </nav>
        </details>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="wrap footer__inner">
        <div class="footer__brand">
          <Logo light />
          <p>{site.footerNote}</p>
        </div>
        <div class="footer__col">
          <h2>Find us</h2>
          <p>{site.address}</p>
          <p><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="footer__col">
          <h2>Around here</h2>
          <ul>{site.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </div>
      <div class="wrap footer__base">
        <span>© {year} Crumb &amp; Co. A made-up bakery for the PageStack demo.</span>
        <span>Wed–Sun, from 7 a.m.</span>
      </div>
    </footer>
  </body>
</html>
