---
// /edit/global/<id> — a site-wide document (menus, footer…) the host declares in its sections module.
import { globals, listPages, opts, publicPath } from '../server/context';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
const id = Astro.params.id!;
if (!Object.hasOwn(globals, id)) return new Response('No such document', { status: 404 });
const def = globals[id];
const boot = {
  id, label: def.label, fields: def.fields,
  pages: (await listPages()).filter((p) => p.status !== 'draft').map((p) => ({ title: p.title.split(/\s[-–|]\s/)[0], url: publicPath(p.slug) })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>{def.label} — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <Nav current="settings" />
    <main class="ps-index__main ps-global">
      <header class="ps-index__head">
        <div>
          <h1>{def.label}</h1>
          {def.description && <p class="ps-muted">{def.description}</p>}
        </div>
        <button type="button" id="ps-global-save" class="ps-btn ps-btn--primary" disabled>Save</button>
      </header>
      <div id="ps-global-form" class="ps-global__form"><p class="ps-muted">Loading…</p></div>
    </main>
    <div id="ps-modal-root"></div>
    <script is:inline set:html={`window.__PS_GLOBAL__ = ${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />
    <script>import '../client/global.ts';</script>
  </body>
</html>
