---
// /edit/login — sign in with a passkey. With auth "none" / "none-behind-proxy" there is nothing
// to do here, so it just links through.
import { opts, secret } from '../server/context';
import { readSession, safeNext } from '../core/auth';
import '../client/shell.css';
export const prerender = false;
const next = safeNext(Astro.url.searchParams.get('next'));
if (opts.auth !== 'passkey') return Astro.redirect(next);
if (await readSession(Astro.request.headers.get('cookie'), secret())) return Astro.redirect(next);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <main class="ps-login" data-ps-auth="login" data-next={next}>
      <h1>{opts.siteName}</h1>
      <p class="ps-muted">Sign in with the passkey you set up for this site.</p>
      <button type="button" class="ps-btn ps-btn--primary" id="ps-auth-go">Sign in with passkey</button>
      <p class="ps-login__error" id="ps-auth-error" hidden></p>
      <p class="ps-muted ps-login__hint">No passkey yet? Ask an existing editor for an invite link.</p>
    </main>
    <script>
      import '../client/auth.ts';
    </script>
  </body>
</html>
