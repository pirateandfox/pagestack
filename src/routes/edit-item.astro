---
// /edit/collection/<id>/<slug> — one Markdown item: its frontmatter as a form, its body with a live preview.
import { collections, listPages, opts, publicPath, storage } from '../server/context';
import { sha256 } from '../core/storage';
import { parseMarkdown } from '../core/frontmatter';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
const id = Astro.params.id!;
const slug = Astro.params.slug ?? '';
if (!Object.hasOwn(collections, id) || !/^[a-z0-9][a-z0-9_-]*$/i.test(slug)) return new Response('Not found', { status: 404 });
const c = collections[id];
const raw = await storage().readFile(`${c.dir}/${slug}.md`);
if (raw === null) return new Response('Not found', { status: 404 });
const { data, body } = parseMarkdown(raw);
const boot = {
  id, slug, singular: c.singular ?? 'item', fields: c.fields, data, body, hash: await sha256(raw),
  viewUrl: c.url?.(slug) ?? null,
  pages: (await listPages()).filter((p) => p.status !== 'draft').map((p) => ({ title: p.title.split(/\s[-–|]\s/)[0], url: publicPath(p.slug) })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Edit: {data.title ?? slug}</title>
  </head>
  <body class="ase-index ase-item">
    <Nav current={`collection-${id}`} />
    <header class="ase-item__top">
      <a href={`/edit/collection/${id}`}>← {c.label}</a>
      <span id="ase-item-status" class="ase-muted"></span>
      <span class="ase-item__actions">
        {boot.viewUrl && <a id="ase-item-view" class="ase-btn ase-btn--ghost" href={boot.viewUrl} target="_blank" rel="noopener">View ↗</a>}
        <button type="button" id="ase-item-draft" class="ase-btn ase-btn--ghost" hidden>Switch to draft</button>
        <button type="button" id="ase-item-save" class="ase-btn" disabled>Save</button>
        <button type="button" id="ase-item-publish" class="ase-btn ase-btn--primary" hidden>Publish</button>
      </span>
    </header>
    <div class="ase-item__grid">
      <main>
        <input id="ase-item-title" class="ase-item__title" type="text" placeholder="Add title" aria-label="Title" />
        <div class="ase-mdbar" id="ase-mdbar" role="toolbar" aria-label="Formatting"></div>
        <div class="ase-mdsplit">
          <textarea id="ase-item-body" aria-label="Content in Markdown" spellcheck="true"></textarea>
          <article id="ase-item-preview" class="ase-mdpreview" aria-label="Preview"></article>
        </div>
      </main>
      <aside id="ase-item-form" class="ase-item__side" aria-label="Details"></aside>
    </div>
    <div id="ase-modal-root"></div>
    <script is:inline set:html={`window.__ASE_ITEM__ = ${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />
    <script>import '../client/item.ts';</script>
  </body>
</html>
