---
// /edit/collection/<id>/<slug> — one Markdown item: its frontmatter as a form, its body with a live preview.
import { collections, listPages, opts, publicPath, storage } from '../server/context';
import { sha256 } from '../core/storage';
import { parseMarkdown } from '../core/frontmatter';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
const id = Astro.params.id!;
const slug = Astro.params.slug ?? '';
if (!Object.hasOwn(collections, id) || !/^[a-z0-9][a-z0-9_-]*$/i.test(slug)) return new Response('Not found', { status: 404 });
const c = collections[id];
const raw = await storage().readFile(`${c.dir}/${slug}.md`);
if (raw === null) return new Response('Not found', { status: 404 });
const { data, body } = parseMarkdown(raw);
const boot = {
  id, slug, singular: c.singular ?? 'item', fields: c.fields, data, body, hash: await sha256(raw),
  viewUrl: c.url?.(slug) ?? null,
  redirects: !!c.url && (await storage().readFile(opts.redirectsFile)) !== null,
  preview: Object.hasOwn(opts.previews ?? {}, id),
  pages: (await listPages()).filter((p) => p.status !== 'draft').map((p) => ({ title: p.title.split(/\s[-–|]\s/)[0], url: publicPath(p.slug) })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Edit: {data.title ?? slug}</title>
  </head>
  <body class="ps-index ps-item">
    <Nav current={`collection-${id}`} />
    <header class="ps-item__top">
      <a href={`/edit/collection/${id}`}>← {c.label}</a>
      {boot.preview && (
        <span class="ps-seg" role="group" aria-label="Edit as">
          <button type="button" class="ps-seg__btn" data-mode="page" aria-pressed="true">Page</button>
          <button type="button" class="ps-seg__btn" data-mode="markdown" aria-pressed="false">Markdown</button>
        </span>
      )}
      <span id="ps-item-status" class="ps-muted"></span>
      <span class="ps-item__actions">
        {boot.viewUrl && <a id="ps-item-view" class="ps-btn ps-btn--ghost" href={`/edit/site?path=${encodeURIComponent(boot.viewUrl)}`} title="See the saved version on the site, and click around from there">View on site</a>}
        {boot.preview && <button type="button" id="ps-item-tab" class="ps-btn ps-btn--ghost">Preview ↗</button>}
        <button type="button" id="ps-item-draft" class="ps-btn ps-btn--ghost" hidden>Switch to draft</button>
        <button type="button" id="ps-item-save" class="ps-btn" disabled>Save</button>
        <button type="button" id="ps-item-publish" class="ps-btn ps-btn--primary" hidden>Publish</button>
        <button type="button" id="ps-item-more" class="ps-iconbtn" title="Options" aria-label="Options" data-icon="more"></button>
      </span>
    </header>
    <div class="ps-item__grid">
      <main>
        {boot.preview && <div class="ps-item__page" id="ps-item-page" hidden><iframe id="ps-item-frame" title="Page preview" sandbox="allow-same-origin"></iframe></div>}
        <div id="ps-item-md">
        <input id="ps-item-title" class="ps-item__title" type="text" placeholder="Add title" aria-label="Title" />
        <div class="ps-mdbar" id="ps-mdbar" role="toolbar" aria-label="Formatting"></div>
        <div class="ps-mdsplit">
          <textarea id="ps-item-body" aria-label="Content in Markdown" spellcheck="true"></textarea>
          <article id="ps-item-preview" class="ps-mdpreview" aria-label="Preview"></article>
        </div>
        </div>
      </main>
      <aside id="ps-item-form" class="ps-item__side" aria-label="Details"></aside>
    </div>
    <div id="ps-modal-root"></div>
    <script is:inline set:html={`window.__PS_ITEM__ = ${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />
    <script>import '../client/item.ts';</script>
  </body>
</html>
