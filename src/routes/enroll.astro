---
// /edit/enroll?invite=<token> — create a passkey from a one-time invite link.
import { opts, secret } from '../server/context';
import { readInvite } from '../core/auth';
import { inviteUsed } from '../core/users';
import { loadUsers } from '../server/webauthn';
import '../client/shell.css';
export const prerender = false;
const token = Astro.url.searchParams.get('invite') ?? '';
let error: string | null = null;
let invite: { name: string; email: string } | null = null;
if (opts.auth !== 'passkey') error = `Passkey sign-in is not enabled for this site (auth: "${opts.auth}").`;
else {
  const inv = await readInvite(token, secret());
  if (!inv) error = 'This invite link is invalid or has expired. Ask for a new one.';
  else if (inviteUsed(await loadUsers(), inv.id)) error = 'This invite link has already been used.';
  else invite = { name: inv.name, email: inv.email };
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>Set up your passkey — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <main class="ps-login" data-ps-auth="enroll" data-invite={invite ? token : undefined}>
      <h1>{opts.siteName}</h1>
      {invite ? (
        <>
          <p>Hi <strong>{invite.name}</strong>. Create a passkey for <strong>{invite.email}</strong> on this device to edit the site. Your device will ask for Touch ID, Face ID, a PIN or a security key.</p>
          <label class="ps-login__label">Name this device (optional) <input type="text" id="ps-auth-label" placeholder="e.g. MacBook, iPhone" maxlength="60" /></label>
          <button type="button" class="ps-btn ps-btn--primary" id="ps-auth-go">Create passkey</button>
        </>
      ) : (
        <p class="ps-login__error">{error}</p>
      )}
      <p class="ps-login__error" id="ps-auth-error" hidden></p>
    </main>
    <script>
      import '../client/auth.ts';
    </script>
  </body>
</html>
