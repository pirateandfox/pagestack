---
// /edit — the Pages screen: every page, with add, duplicate, delete and search.
import { collections, globals, listPages, opts, publicPath, reservedSlugs, templates } from '../server/context';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
if (opts.pages === false) {
  const first = Object.keys(collections)[0];
  return Astro.redirect(first ? `/edit/collection/${first}` : '/edit/media');
}
const pages = await listPages();
const boot = {
  pages: pages.map((p) => ({ slug: p.slug, title: p.title })),
  reserved: reservedSlugs(),
  templates: templates.map((t, i) => ({ id: i, label: t.label, description: t.description })),
};
const globalLinks = Object.entries(globals).map(([id, g]) => ({ id, label: g.label, description: g.description }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>{opts.siteName} — pages</title>
  </head>
  <body class="ps-index">
    <Nav current="pages" />
    <main class="ps-index__main">
      <header class="ps-index__head">
        <div>
          <h1>{opts.siteName}</h1>
          <p class="ps-muted">Saving {opts.storage === 'github' ? 'commits to GitHub' : 'writes to the working tree'}.</p>
        </div>
        <button type="button" id="ps-add-page" class="ps-btn ps-btn--primary">Add page</button>
      </header>
      {globalLinks.length > 0 && (
        <nav class="ps-globals" aria-label="Site settings">
          {globalLinks.map((g) => <a href={`/edit/global/${g.id}`}><strong>{g.label}</strong>{g.description && <span class="ps-muted">{g.description}</span>}</a>)}
        </nav>
      )}
      <div class="ps-index__tools">
        <h2>Pages <span class="ps-muted">{pages.length}</span></h2>
        <input type="search" id="ps-page-search" placeholder="Search pages" aria-label="Search pages" />
      </div>
      <ul class="ps-pagelist" id="ps-pagelist">
        {pages.map((p) => (
          <li data-slug={p.slug} data-search={`${p.title} ${p.slug}`.toLowerCase()}>
            <a class="ps-pagelist__edit" href={`/edit/${p.slug}`}><strong>{p.title}{p.status === 'draft' && <span class="ps-pill">Draft</span>}</strong><span class="ps-muted">{publicPath(p.slug)} · {p.sections} {p.sections === 1 ? 'section' : 'sections'}</span></a>
            <div class="ps-pagelist__actions">
              {p.status !== 'draft' && <a class="ps-btn ps-btn--small ps-btn--ghost" href={`/edit/site?path=${encodeURIComponent(publicPath(p.slug))}`}>View</a>}
              <button type="button" class="ps-btn ps-btn--small ps-btn--ghost" data-duplicate={p.slug}>Duplicate</button>
              {p.slug !== 'index' && <button type="button" class="ps-btn ps-btn--small ps-btn--ghost ps-btn--danger" data-delete={p.slug}>Delete</button>}
            </div>
          </li>
        ))}
      </ul>
      {!pages.length && <p>No pages yet in <code>{opts.pagesDir}</code>. Add the first one.</p>}
      <p id="ps-no-match" class="ps-muted" hidden>No pages match.</p>
    </main>
    <script is:inline set:html={`window.__PS_PAGES__ = ${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />
    <script>import '../client/pages.ts';</script>
  </body>
</html>
