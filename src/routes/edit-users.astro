---
// /edit/users — who can edit, their passkeys, and invites. Admins only.
import { isAdmin, opts } from '../server/context';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
if (!isAdmin(Astro.locals)) return Astro.redirect('/edit');
const passkey = opts.auth === 'passkey';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>Users — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <Nav current="users" />
    <main class="ps-index__main">
      <header class="ps-index__head"><div><h1>Users</h1><p class="ps-muted">Admins manage people and can write raw HTML. Editors do everything else.</p></div></header>
      {passkey ? (
        <>
          <ul class="ps-pagelist" id="ps-users"></ul>
          <details class="ps-invite" open>
            <summary>Invite someone</summary>
            <form id="ps-invite" class="ps-invite__form">
              <input type="text" name="name" placeholder="Name" required />
              <input type="email" name="email" placeholder="Email" required />
              <select name="role" aria-label="Role"><option value="editor">Editor</option><option value="admin">Admin</option></select>
              <button type="submit" class="ps-btn ps-btn--primary ps-btn--small">Create invite link</button>
              <output></output>
            </form>
            <p class="ps-muted">The link lets them create a passkey for this site. It works once and expires after 3 days. Their public key is committed to <code>{opts.usersFile}</code>; nothing secret is stored.</p>
          </details>
        </>
      ) : <p>People are managed by your login proxy, not here.</p>}
    </main>
    <div id="ps-modal-root"></div>
    {passkey && <script>import '../client/users.ts';</script>}
    {passkey && <script>import '../client/invite.ts';</script>}
  </body>
</html>
