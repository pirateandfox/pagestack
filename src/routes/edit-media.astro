---
// /edit/media — the image library: browse, upload, see where an image is used, delete.
import { opts } from '../server/context';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>Media — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <Nav current="media" />
    <main class="ps-index__main ps-media">
      <header class="ps-index__head">
        <div><h1>Media <span class="ps-muted" id="ps-media-count"></span></h1><p class="ps-muted">Drop images anywhere on this page to upload them.</p></div>
        <label class="ps-btn ps-btn--primary">Upload<input type="file" id="ps-media-file" accept="image/*" multiple hidden /></label>
      </header>
      <div class="ps-index__tools"><input type="search" id="ps-media-search" placeholder="Search images" aria-label="Search images" /></div>
      <div id="ps-media-grid" class="ps-media__grid" role="list"></div>
    </main>
    <div class="ps-media__drop" hidden>Drop images to upload</div>
    <div id="ps-modal-root"></div>
    <script>import '../client/media.ts';</script>
  </body>
</html>
