---
// The bar across the top of every screen except the block editor, which has its own.
import { collections, editorOf, globals, opts } from '../server/context';
const { current } = Astro.props as { current: string };
const user = editorOf(Astro.locals);
const firstGlobal = Object.keys(globals)[0];
const links = [
  ...(opts.pages === false ? [] : [{ id: 'pages', label: 'Pages', href: '/edit' }]),
  ...Object.entries(collections).map(([id, c]) => ({ id: `collection-${id}`, label: c.label, href: `/edit/collection/${id}` })),
  { id: 'media', label: 'Media', href: '/edit/media' },
  ...(firstGlobal ? [{ id: 'settings', label: Object.keys(globals).length > 1 ? 'Site settings' : globals[firstGlobal].label, href: `/edit/global/${firstGlobal}` }] : []),
  ...(opts.auth === 'passkey' && user?.role === 'admin' ? [{ id: 'users', label: 'Users', href: '/edit/users' }] : []),
];
---
<nav class="ps-nav" aria-label="Editor">
  <a class="ps-nav__site" href="/edit">{opts.siteName}</a>
  {links.map((l) => <a href={l.href} aria-current={l.id === current ? 'page' : undefined}>{l.label}</a>)}
  <span class="ps-nav__user">
    <a href="/edit/site" aria-current={current === 'site' ? 'page' : undefined}>Browse site</a>
    {opts.github?.live && <button type="button" id="ps-live" class="ps-btn ps-btn--primary ps-live" hidden>Publish changes</button>}
    {user && opts.auth === 'passkey' && <span>Signed in as <strong>{user.name}</strong> · <a href="/api/editor/auth/logout">Sign out</a></span>}
  </span>
</nav>
<script>import '../client/live.ts';</script>
