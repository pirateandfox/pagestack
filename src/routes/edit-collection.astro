---
// /edit/collection/<id> — the items of a Markdown collection, e.g. blog posts.
import { collections, listItems, opts, reservedSlugs } from '../server/context';
import Nav from './Nav.astro';
import '../client/shell.css';
export const prerender = false;
const id = Astro.params.id!;
if (!Object.hasOwn(collections, id)) return new Response('No such collection', { status: 404 });
const c = collections[id];
const items = await listItems(c);
const singular = c.singular ?? 'item';
const boot = { id, singular, slugs: items.map((i) => i.slug), reserved: reservedSlugs() };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 64 64%27%3E%3Crect x=%276%27 y=%2730%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.22%27/%3E%3Crect x=%2712%27 y=%2720%27 width=%2740%27 height=%2726%27 rx=%276%27 fill=%27%231e1e1e%27 opacity=%27.5%27/%3E%3Crect x=%2718%27 y=%278%27 width=%2740%27 height=%2728%27 rx=%276%27 fill=%27%232563eb%27/%3E%3C/svg%3E" />
    <title>{c.label} — {opts.siteName}</title>
  </head>
  <body class="ps-index">
    <Nav current={`collection-${id}`} />
    <main class="ps-index__main">
      <header class="ps-index__head">
        <div><h1>{c.label} <span class="ps-muted">{items.length}</span></h1></div>
        {c.create !== false && <button type="button" id="ps-add-item" class="ps-btn ps-btn--primary">Add {singular}</button>}
      </header>
      <div class="ps-index__tools"><input type="search" id="ps-page-search" placeholder={`Search ${c.label.toLowerCase()}`} aria-label="Search" /></div>
      <ul class="ps-pagelist" id="ps-pagelist">
        {items.map((i) => (
          <li data-slug={i.slug} data-search={`${i.title} ${i.slug}`.toLowerCase()}>
            <a class="ps-pagelist__edit" href={`/edit/collection/${id}/${i.slug}`}><strong>{i.title}{i.draft && <span class="ps-pill">Draft</span>}</strong><span class="ps-muted">{i.date.slice(0, 10)}</span></a>
            <div class="ps-pagelist__actions">
              {!i.draft && c.url && <a class="ps-btn ps-btn--small ps-btn--ghost" href={`/edit/site?path=${encodeURIComponent(c.url(i.slug))}`}>View</a>}
              <button type="button" class="ps-btn ps-btn--small ps-btn--ghost ps-btn--danger" data-delete={i.slug}>Delete</button>
            </div>
          </li>
        ))}
      </ul>
      <p id="ps-no-match" class="ps-muted" hidden>Nothing matches.</p>
    </main>
    <div id="ps-modal-root"></div>
    <script is:inline set:html={`window.__PS_COLLECTION__ = ${JSON.stringify(boot).replace(/</g, '\\u003c')};`} />
    <script>import '../client/collection.ts';</script>
  </body>
</html>
