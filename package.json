{
  "name": "@pirateandfox/pagestack",
  "version": "0.1.0-beta.11",
  "description": "A block editor for Astro sites. Content stays in your repo, saves are git commits, the public site stays static, sign-in is passkeys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pagestack-invite": "bin/invite.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./runtime": "./src/runtime.ts",
    "./core/*": "./src/core/*.ts",
    "./live": "./live.mjs"
  },
  "files": [
    "index.mjs",
    "live.mjs",
    "bin",
    "src"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": ">=7.2.1",
    "@astrojs/cloudflare": ">=13"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.0.0",
    "marked": "^18.1.3",
    "sortablejs": "^1.15.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.8",
    "happy-dom": "^21.0.4",
    "parse5": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "visual-editor",
    "cms",
    "git-based-cms",
    "sections",
    "astro",
    "block-editor",
    "page-builder",
    "static-site",
    "passkeys",
    "webauthn",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirateandfox/pagestack.git"
  },
  "homepage": "https://github.com/pirateandfox/pagestack#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependenciesMeta": {
    "@astrojs/cloudflare": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/pirateandfox/pagestack/issues"
  },
  "author": "Pirate & Fox LLC (https://pirateandfox.com)"
}
