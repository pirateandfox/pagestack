{
  "name": "@pirateandfox/pagestack",
  "version": "0.1.0-beta.4",
  "description": "PageStack: visual section editor for Astro sites. Git-only, static public site, passkey login, saves are commits.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pagestack-invite": "bin/invite.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./runtime": "./src/runtime.ts",
    "./core/*": "./src/core/*.ts"
  },
  "files": [
    "index.mjs",
    "bin",
    "src"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.0.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.8",
    "happy-dom": "^21.0.4",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "visual-editor",
    "cms",
    "git-based-cms",
    "sections"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirateandfox/pagestack.git"
  },
  "homepage": "https://github.com/pirateandfox/pagestack#readme",
  "publishConfig": {
    "access": "public"
  }
}
