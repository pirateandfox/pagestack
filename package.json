{
  "name": "astro-section-editor",
  "version": "0.1.0-beta.1",
  "description": "Git-only visual section editor for Astro sites: static public site, passkey login, saves are commits.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "astro-section-editor-invite": "bin/invite.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./runtime": "./src/runtime.ts",
    "./core/*": "./src/core/*.ts"
  },
  "files": [
    "index.mjs",
    "bin",
    "src"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "@astrojs/node": "10.1.1",
    "@simplewebauthn/browser": "^13.0.0",
    "@simplewebauthn/server": "^13.0.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.8",
    "happy-dom": "^21.0.4",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirateandfox/astro-section-editor.git"
  },
  "homepage": "https://github.com/pirateandfox/astro-section-editor#readme",
  "publishConfig": {
    "access": "public"
  }
}
